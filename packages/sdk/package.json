{
  "name": "@wse/sdk",
  "version": "2.0.0",
  "private": true,
  "description": "Webshop Engine SDK: template/plugin contracts, theme tokens, shared types.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./templates/types": "./src/templates/types.ts",
    "./plugins/types": "./src/plugins/types.ts",
