{
  "name": "@wse/sdk",
  "version": "2.0.0",
  "description": "Webshop Engine SDK: template/plugin contracts, theme tokens, shared types.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./templates/types": "./src/templates/types.ts",
    "./plugins/types": "./src/plugins/types.ts",
    "./theme/theme-token-keys": "./src/theme/theme-token-keys.ts",
    "./theme/tokens": "./src/theme/tokens.ts",
    "./theme/*": "./src/theme/*.ts",
    "./admin": "./src/admin/index.ts",
    "./admin/*": "./src/admin/*.ts",
    "./contracts": "./src/contracts.ts",
    "./i18n/constants": "./src/i18n/constants.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "zod": ">=4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tomkoooo/webshop.git",
    "directory": "packages/sdk"
  }
}
