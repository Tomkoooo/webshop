{
  "name": "@wse/core",
  "version": "2.0.0",
  "description": "Webshop Engine core: services, models, storefront components, app routes, admin-facing services.",
  "type": "module",
  "exports": {
    "./*": "./src/*.ts",
    "./app/*": "./src/app/*",
    "./components/*": "./src/components/*",
    "./features/*": "./src/features/*",
    "./templates/*": "./src/templates/*",
    "./plugins/*": "./src/plugins/*"
  },
  "dependencies": {
    "@wse/sdk": "*"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Tomkoooo/webshop.git",
    "directory": "packages/core"
  }
}
